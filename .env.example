# Base URL of the backend API (must include /api/v1)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Google Sign-In (web). Create a Web OAuth 2.0 client ID in Google Cloud
# Console (APIs & Services > Credentials) with this app's origin(s) as
# authorized JavaScript origins. Must match a value the backend accepts —
# see backend/.env.example's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=77570300823-1ppslrp06ulf9cbh78ofu4tc5p10r59l.apps.googleusercontent.com
